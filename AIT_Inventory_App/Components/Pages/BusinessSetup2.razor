@page "/setup"
@using System.ComponentModel.DataAnnotations
@using Common.Users2
@using Domain.Users2
@using Service.IService
@layout LoginLayout
@inject NavigationManager Navigation
@inject IAuthService2 Auth

<h1>Business Setup</h1>
<p>Create your business and the owner account. The owner creates all other users and decides what each role can see.</p>

@if (checking)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@model" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h4>Business</h4>
        <InputText @bind-Value="model.BusinessName" placeholder="Business name" style="display:block; width:100%; padding:8px; margin-bottom:8px;" />
        <InputText @bind-Value="model.Address" placeholder="Address" style="display:block; width:100%; padding:8px; margin-bottom:8px;" />
        <InputText @bind-Value="model.City" placeholder="City (optional)" style="display:block; width:100%; padding:8px; margin-bottom:8px;" />
        <InputText @bind-Value="model.Phone" placeholder="Phone (optional)" style="display:block; width:100%; padding:8px; margin-bottom:8px;" />
        <InputText @bind-Value="model.BusinessEmail" placeholder="Business email (optional)" style="display:block; width:100%; padding:8px; margin-bottom:8px;" />
        <InputText @bind-Value="model.TaxNumber" placeholder="Tax / NTN number (optional)" style="display:block; width:100%; padding:8px; margin-bottom:12px;" />

        <h4>Owner account</h4>
        <InputText @bind-Value="model.OwnerUserName" placeholder="Your user name" style="display:block; width:100%; padding:8px; margin-bottom:8px;" />
        <InputText @bind-Value="model.OwnerEmail" placeholder="Your email" style="display:block; width:100%; padding:8px; margin-bottom:8px;" />
        <InputText @bind-Value="model.Password" type="password" placeholder="Password (min 8 characters)" style="display:block; width:100%; padding:8px; margin-bottom:8px;" />
        <InputText @bind-Value="model.ConfirmPassword" type="password" placeholder="Confirm password" style="display:block; width:100%; padding:8px; margin-bottom:12px;" />

        <button type="submit" disabled="@busy" style="padding:8px 20px;">Create business</button>
    </EditForm>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p style="color:red; margin-top:10px;">@errorMessage</p>
}

@code {
    private readonly SetupForm2 model = new();
    private string? errorMessage;
    private bool checking = true;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetStartupStateAsync();
        if (state.Success && !state.Data.SetupRequired)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!state.Success)
            errorMessage = state.Errors != null && state.Errors.Count > 0 ? string.Join(" ", state.Errors) : "The database could not be reached.";

        checking = false;
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        busy = true;

        var request = new BusinessSetupRequestDto2
        {
            BusinessName = model.BusinessName,
            Address = model.Address,
            City = model.City,
            Phone = model.Phone,
            BusinessEmail = model.BusinessEmail,
            TaxNumber = model.TaxNumber,
            OwnerUserName = model.OwnerUserName,
            OwnerEmail = model.OwnerEmail,
            Password = model.Password,
            ConfirmPassword = model.ConfirmPassword
        };

        var result = await Auth.SetupBusinessAsync(request);
        busy = false;

        if (result.Success)
        {
            Navigation.NavigateTo(ScreenCatalog2.FirstAllowedRoute(result.Data.AllowedScreens, result.Data.IsRoot));
        }
        else
        {
            errorMessage = result.Errors != null && result.Errors.Count > 0 ? string.Join("  •  ", result.Errors) : "Setup failed.";
        }
    }

    public class SetupForm2
    {
        [Required(ErrorMessage = "Business name is required")]
        public string BusinessName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Address is required")]
        public string Address { get; set; } = string.Empty;

        public string? City { get; set; }
        public string? Phone { get; set; }
        public string? BusinessEmail { get; set; }
        public string? TaxNumber { get; set; }

        [Required(ErrorMessage = "User name is required")]
        public string OwnerUserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        public string OwnerEmail { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm the password")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
