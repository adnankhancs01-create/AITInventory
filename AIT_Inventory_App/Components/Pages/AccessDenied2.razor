@page "/access-denied"
@using Domain.Users2
@inject ICurrentUser2 CurrentUser
@inject NavigationManager Navigation

<h3>Access denied</h3>
<p>Your role does not have access to this screen.</p>
<p>If you need it, ask the business owner to enable it for your role.</p>

@if (CurrentUser.IsAuthenticated && CurrentUser.CanView(ScreenCatalog2.Home))
{
    <RadzenButton Text="Go to Home" ButtonStyle="ButtonStyle.Primary" Click="@(() => Navigation.NavigateTo("/home"))" />
}
