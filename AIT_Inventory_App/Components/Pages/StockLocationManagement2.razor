@page "/stock2/locations"
@using Common.Stock2
@using Service.IService
@inject IStockMasterService2 StockMaster
@inject DialogService DialogService
@using AIT_Inventory_App.Components.StockParts2

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
    <h3 style="margin:0;">Warehouses and Locations</h3>
    <RadzenButton Text="New location" Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Click="NewLocation" />
</div>

@if (editing != null)
{
    <RadzenCard Style="margin-bottom:16px;">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="12px" Style="flex-wrap:wrap; align-items:flex-end;">
            <div>
                <label style="font-size:12px; color:#6c757d;">Code</label>
                <RadzenTextBox @bind-Value="editing.Code" MaxLength="20" Style="width:140px" />
            </div>
            <div>
                <label style="font-size:12px; color:#6c757d;">Name</label>
                <RadzenTextBox @bind-Value="editing.Name" MaxLength="100" Style="width:220px" />
            </div>
            <div>
                <label style="font-size:12px; color:#6c757d;">Address</label>
                <RadzenTextBox @bind-Value="editing.Address" MaxLength="250" Style="width:280px" />
            </div>
            <RadzenCheckBox TValue="bool" @bind-Value="editing.IsActive" Name="active" Disabled="@editing.IsDefault" />
            <RadzenLabel Text="Active" Component="active" />
            <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="SaveAsync" Disabled="@saving" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => editing = null)" />
        </RadzenStack>
    </RadzenCard>
}

<RadzenDataGrid AllowColumnResize="true" TItem="StockLocationDto2" Data="@locations" AllowSorting="true" AllowPaging="true" PageSize="20">
    <Columns>
        <RadzenDataGridColumn TItem="StockLocationDto2" Property="Code" Title="Code" />
        <RadzenDataGridColumn TItem="StockLocationDto2" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="StockLocationDto2" Property="Address" Title="Address" />
        <RadzenDataGridColumn TItem="StockLocationDto2" Property="IsDefault" Title="Default" />
        <RadzenDataGridColumn TItem="StockLocationDto2" Property="IsActive" Title="Active" />
        <RadzenDataGridColumn TItem="StockLocationDto2" Title="Actions" Sortable="false">
            <Template Context="row">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => Edit(row))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    private List<StockLocationDto2> locations = new();
    private StockLocationDto2? editing;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await StockMaster.GetLocationsAsync(true);
        if (await StockUi2.ShowResultAsync(DialogService, result, false))
            locations = result.Data;
    }

    private void NewLocation()
    {
        editing = new StockLocationDto2 { IsActive = true };
    }

    private void Edit(StockLocationDto2 row)
    {
        editing = new StockLocationDto2
        {
            Id = row.Id, Code = row.Code, Name = row.Name, Address = row.Address,
            IsDefault = row.IsDefault, IsActive = row.IsActive
        };
    }

    private async Task SaveAsync()
    {
        if (editing == null) return;
        saving = true;
        var result = await StockMaster.SaveLocationAsync(editing);
        saving = false;
        if (await StockUi2.ShowResultAsync(DialogService, result))
        {
            editing = null;
            await LoadAsync();
        }
    }
}
