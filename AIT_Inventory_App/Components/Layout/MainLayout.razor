@using Domain.Users2
@using Service.IService
@inject NavigationManager Navigation
@inject IAuthService2 Auth
@inject ICurrentUser2 CurrentUser
@inherits LayoutComponentBase
<RadzenDialog />
<div class="layout">
    <!-- Sidebar -->
    <aside class="sidebar @(isSidebarCollapsed ? "collapsed" : "")">
        <NavMenu />
    </aside>

    <!-- Main -->
    <div class="main-area">

        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-left">

                <!-- Toggle Button -->
                <button class="toggle-btn" @onclick="ToggleSidebar">
                    <i class="bi bi-list"></i>
                </button>

                <span class="app-title">@(string.IsNullOrWhiteSpace(CurrentUser.BusinessName) ? "Inventory System" : CurrentUser.BusinessName)</span>
            </div>

            <div class="topbar-right">
                @if (CurrentUser.IsAuthenticated)
                {
                    <span class="about-link" style="margin-right:12px;">
                        @CurrentUser.UserName (@CurrentUser.RoleName)
                    </span>
                }

                <a href="https://www.facebook.com/AdvancedInstituteOfTechnology26/"
                   target="_blank"
                   class="about-link">
                    About
                </a>

                <button class="logout-btn" @onclick="HandleLogout">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </div>
        </header>

        <!-- Content -->
        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isSidebarCollapsed = false;

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private async Task HandleLogout()
    {
        // Clear the session first; the forced reload then lands on the login page.
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/", true);
    }
}
